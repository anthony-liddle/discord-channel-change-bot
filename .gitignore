# Dependencies
node_modules/

# Build output
dist/

# Environment variables
.env

# Config with sensitive data
config.json

# State file (optional - you may want to track this)
state.json

# Themes file (optional - you may want to track this)
themes.json

# Logs
*.log

# Coverage reports, generated by pnpm test:coverage
coverage/

# Worktrees made by Claude Code. Each holds a full checkout with its own .git,
# which a git add -A here would pick up as an embedded repository.
.claude/worktrees/

# OS files
.DS_Store
Thumbs.db

# Vanilla NPM
package-lock.json

# Community-specific content that must never be published. docs/HOSTING.md is
# the generic procedure; the actual theme names, messages and rotation position
# live here and stay local.
docs/THEME-LIST.md
backups/
